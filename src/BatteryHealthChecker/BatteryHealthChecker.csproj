<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BatteryHealthChecker</AssemblyName>
    <RootNamespace>BatteryHealthChecker</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Product identity (SRS 26 - About screen) -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Battery Health Checker</Product>
    <Company>Battery Health Checker</Company>
    <Description>Portable Windows laptop battery diagnostic utility. Offline, no installation.</Description>
    <Copyright>Copyright (c) 2026</Copyright>
  </PropertyGroup>

  <!--
    SRS 1 / 28 / 29 - single standalone portable EXE.
    These settings are the contract: self-contained + single file + native libraries
    and content folded into the executable, so the release folder contains only
    BatteryHealthChecker.exe.
  -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- WinForms does not support trimming; keep it off rather than ship a broken EXE. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Drops the ICU payload (~30 MB) and pins formatting to the invariant culture. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BatteryHealthChecker.Tests" />
  </ItemGroup>

</Project>
